    "fields": [
      {
        "empty": "refused",
        "meaning": "Prime's finding about the measured return.",
        "name": "finding",
        "null": "refused",
        "owner": "intelligence",
        "presence": "required",
        "type": "string"
      },
      {
        "meaning": "Evidence-based reasons. An explicit empty list is a supplied empty account, not a default.",
        "name": "reasons",
        "null": "refused",
        "owner": "intelligence",
        "presence": "required",
        "type": "list"
      },
      {
        "meaning": "continue, director-input, develop, or complete. Not a command.",
        "name": "operation",
        "owner": "intelligence",
        "presence": "required",
        "type": "enum",
        "values": [
          "continue",
          "director-input",
          "develop",
          "complete"
        ]
      },
      {
        "meaning": "accepted, held, or correction-required. Accepted is not Director consent.",
        "name": "disposition",
        "owner": "intelligence",
        "presence": "required",
        "type": "enum",
        "values": [
          "accepted",
          "held",
          "correction-required"
        ]
      },
      {
        "meaning": "finished or open.",
        "name": "pass_terminal",
        "owner": "intelligence",
        "presence": "required",
        "type": "enum",
        "values": [
          "finished",
          "open"
        ]
      },
      {
        "meaning": "completed or open. Completed is allowed only with operation complete.",
        "name": "goal_terminal",
        "owner": "intelligence",
        "presence": "required",
        "type": "enum",
        "values": [
          "completed",
          "open"
        ]
      },
      {
        "empty": "refused",
        "meaning": "The next action Prime supplies. Compute does not invent one.",
        "name": "next_action",
        "null": "refused",
        "owner": "intelligence",
        "presence": "required",
        "type": "string"
      },
      {
        "meaning": "True, false, or null. Null is the legal unknown. Omission is a missing field, not false.",
        "name": "semantic_conflict",
        "owner": "intelligence",
        "presence": "required",
        "type": "boolean-or-null"
      },
      {
        "meaning": "Null, or an object with id and text.",
        "name": "design_fork",
