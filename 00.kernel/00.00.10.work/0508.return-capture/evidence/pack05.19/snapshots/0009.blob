"""Pack B #06: render the desk view 00.live.md from the canonical assignment record. Development tooling,
not a seated runtime module. It reads two inputs and writes one file; it runs nothing else.

  python -B render_live.py render --root <workspace> [--out <file>]
  python -B render_live.py check  --root <workspace>

Inputs, relative to the workspace root:
  record    00.kernel/00.00.10.work/0401.goal/06.01.md        (schema: 0410.imports, assignment-record v1)
  register  00.kernel/00.00.10.work/0410.imports/manifests/step03-selection-register.tsv
The view names both inputs and their SHA-256. The output is a pure function of the inputs (no clock), so
two processes render the same bytes. `check` regenerates in memory and compares; a view that differs is
refused. The view is never read as an input, so a tampered view cannot change the assignment.
Exit 0 ok, 2 refused.
"""
import argparse, csv, hashlib, io, sys
from pathlib import Path

RECORD = "00.kernel/00.00.10.work/0401.goal/06.01.md"
REGISTER = "00.kernel/00.00.10.work/0410.imports/manifests/step03-selection-register.tsv"
VIEW = "00.kernel/00.live.md"
KEYS = ["record", "schema", "desk", "book", "workflow_space", "current_work", "pack", "assignment_state", "waits_on", "next", "updated"]
STATES = {"waiting", "released", "running", "returned", "accepted", "stopped"}
SCHEMA = "00.kernel/00.00.10.work/0410.imports/01.md#assignment-record version 1"


class Refuse(Exception):
    pass


def parse_record(data):
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise Refuse("record is not UTF-8")
    if "\r" in text:
        raise Refuse("record has CR line endings")
    fields = {}
    for n, line in enumerate(text.split("\n"), 1):
        if line == "" and n == len(text.split("\n")):
            continue
        if ": " not in line:
            raise Refuse(f"record line {n} is not 'key: value'")
        k, v = line.split(": ", 1)
        if k not in KEYS:
            raise Refuse(f"record has an unknown key: {k}")
        if k in fields:
            raise Refuse(f"record repeats a key: {k}")
        if not v.strip():
            raise Refuse(f"record key has an empty value: {k}")
        fields[k] = v
    missing = [k for k in KEYS if k not in fields]
    if missing:
        raise Refuse(f"record misses keys: {', '.join(missing)}")
    if fields["record"] != "current-assignment" or fields["schema"] != SCHEMA:
        raise Refuse("record is not a version 1 current-assignment record")
    if fields["assignment_state"] not in STATES:
        raise Refuse(f"assignment_state is not one of {sorted(STATES)}")
    if not fields["workflow_space"].isdigit():
        raise Refuse("workflow_space is not a number")
    return fields


def read(root, rel):
    p = Path(root) / rel
    if not p.is_file():
        raise Refuse(f"missing input: {rel}")
    return p.read_bytes()


def render(root):
    rec_b, reg_b = read(root, RECORD), read(root, REGISTER)
    f = parse_record(rec_b)
    rows = list(csv.DictReader(io.StringIO(reg_b.decode("utf-8")), delimiter="\t"))
    if not rows or "status" not in rows[0]:
        raise Refuse("selection register is empty or has no status column")
    counts = {}
    for r in rows:
        counts[r["status"]] = counts.get(r["status"], 0) + 1
    me = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    out = [
        "# 00.live",
        "",
        "Derived view. Not an input to anything. Regenerate or check it before relying on it; the record wins.",
        f"generated by: labs/bootstrap-establish-pass01/render_live.py (sha256 {me})",
        f"record: {RECORD} (sha256 {hashlib.sha256(rec_b).hexdigest()})",
        f"register: {REGISTER} (sha256 {hashlib.sha256(reg_b).hexdigest()})",
        "",
        "## Now",
        f"desk: {f['desk']}",
        f"book: {f['book']}",
        f"workflow space: {f['workflow_space']}",
        f"current work: {f['current_work']}",
        f"pack: {f['pack']}",
        f"state: {f['assignment_state']}",
        f"waits on: {f['waits_on']}",
        f"next: {f['next']}",
        f"updated: {f['updated']}",
        "",
        "## Selected copies in the books",
    ] + [f"{k}: {v}" for k, v in sorted(counts.items())] + [
        "",
        "## Not",
        "No runtime module is active. No loader is seated. This view runs nothing.",
        "",
    ]
    return "\n".join(out).encode("utf-8")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", choices=("render", "check"))
    ap.add_argument("--root", required=True)
    ap.add_argument("--out")
    a = ap.parse_args()
    try:
        data = render(a.root)
        if a.cmd == "render":
            out = Path(a.out) if a.out else Path(a.root) / VIEW
            out.write_bytes(data)
            print(f"rendered {out} ({hashlib.sha256(data).hexdigest()})")
        else:
            view = Path(a.root) / VIEW
            if not view.is_file():
                raise Refuse(f"missing view: {VIEW}")
            if view.read_bytes() != data:
                raise Refuse(f"{VIEW} does not match the record: regenerate it; the record wins")
            print(f"check: {VIEW} matches the record")
    except Refuse as e:
        print(f"stop: {e}")
        sys.exit(2)


if __name__ == "__main__":
    main()
