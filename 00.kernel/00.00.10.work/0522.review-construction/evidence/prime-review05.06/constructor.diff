+def inspect_target(root: Path, rel: str, binding: str | None) -> dict:
+    if binding is not None:
+        need(isinstance(binding, str) and HEX64.fullmatch(binding) is not None, "bad binding")
+    target = under(root, rel, "target")
+    if not os.path.lexists(target):
+        return {
+            "schema": INSPECT_SCHEMA,
+            "state": "absent",
+            "rule": "target file is absent; this entry does not create targets (permit_create false)",
+            "target_sha256": None,
+            "target_bytes": None,
+            "section_sha256": None,
+            "binding_sha256": None,
+        }
+    data = read_regular(target, "target")
+    base = {
+        "schema": INSPECT_SCHEMA,
+        "target_sha256": sha256_bytes(data),
+        "target_bytes": len(data),
+        "section_sha256": None,
+        "binding_sha256": None,
+    }
+    try:
+        sep = newline_of(data)
+        _prefix, current, _suffix = locate(data, sep)
+        text = current.decode("utf-8")
+    except Refusal as exc:
+        return {**base, "state": "unsupported", "rule": exc.message}
+    section_sha = sha256_bytes(current)
+    match = re.search(r"(?m)^task_binding: ([0-9a-f]{64})$", text)
+    found = match.group(1) if match else None
+    if text.strip() in {"PENDING", "PENDING."}:
+        return {
+            **base,
+            "state": "pending",
+            "rule": None,
+            "section_sha256": section_sha,
+            "binding_sha256": found,
+        }
+    if found and binding and found == binding:
+        return {
+            **base,
+            "state": "constructed-same-binding",
+            "rule": "a constructed review for this task binding is present; render is idempotent only if the body is identical",
+            "section_sha256": section_sha,
+            "binding_sha256": found,
+        }
+    return {
+        **base,
+        "state": "existing-review",
+        "rule": "existing review conflicts; a successor process is required and this review was not overwritten",
+        "section_sha256": section_sha,
+        "binding_sha256": found,
+    }
+
+
