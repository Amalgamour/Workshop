{
  "digest_guard": "digest-mismatch",
  "fence_probes": [
    {
      "case": "mixed",
      "count": 1,
      "exact_real_cut": true
    },
    {
      "case": "long",
      "count": 1,
      "exact_real_cut": true
    },
    {
      "case": "indent",
      "count": 1,
      "exact_real_cut": true
    }
  ]
}
